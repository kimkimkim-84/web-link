# SonicWall 방화벽 접속 정보 (읽기 전용 계정 권장)
SONICWALL_HOST=192.168.1.1
SONICWALL_PORT=443
# 권장: 비밀번호는 Windows 자격 증명 관리자에 저장 (python save_password.py)
SONICWALL_CRED_TARGET=SonicWallMCP/API
# 자체서명 인증서: python fetch_cert.py <IP> 로 지문 확인 후 설정
# SONICWALL_CERT_SHA256=<64자리 지문>
# 자격 증명 관리자를 쓸 수 없는 환경에서만:
# SONICWALL_USER=mcp-readonly
# SONICWALL_PASSWORD=change-me
